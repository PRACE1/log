# R2 / Cloudflare (server-side only — never VITE_* prefix these).
# Values live in .env.local (copied from C:\Users\0\.buzz\.env.local).
# Server code should use the same fallback pattern as ui-kit:
#   R2_BUCKET ?? R2_MEDIA_BUCKET
#   CLOUDFLARE_R2_API_TOKEN ?? CLOUDFLARE_API_TOKEN
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_ACCESS_KEY_ID=
R2_MEDIA_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=
R2_BUCKET=

# Onboarding video (public URL, safe to expose — e.g. an R2 public URL).
# Falls back to a VidStack demo asset when unset.
VITE_ONBOARDING_VIDEO_URL=
